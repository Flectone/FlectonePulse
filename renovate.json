{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "labels": ["dependencies"],
  "semanticCommitType": "build",
  "commitMessagePrefix": "chore(deps): ",
  "packageRules": [
    {
      "matchPackageNames": ["net.fabricmc:fabric-loader"],
      "registryUrls": ["https://maven.fabricmc.net/"]
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "matchPackageNames": ["eu.pb4:placeholder-api", "maven.modrinth:vanish"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-(?<prerelease>[^+]+))?\\+(?<compatibility>.+)$"
    },
    {
      "matchFileNames": [
        "minecraft-fabric/intermediary/**",
        "minecraft-fabric/official/*/gradle.properties",
        "minecraft-neoforge/gradle.properties",
        "minecraft-neoforge/*/gradle.properties"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": ["io.papermc.paper:paper-api", "org.spigotmc:spigot-api", "io.github.llamalad7:mixinextras-fabric"],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "com.loohp:InteractiveChat",
        "dev.lone:api-itemsadder",
        "com.mojang:authlib",
        "com.gitlab.ruany:LiteBansAPI",
        "curse.maven:hyui-1431415"
      ],
      "enabled": false
    }
  ]
}
